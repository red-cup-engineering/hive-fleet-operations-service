    { "input.amount": { "matches": "\\sHBD$" } },
    { "input.decoded": { "somewhere": { "contractAction": "stake", "contractPayload.symbol": { "matches": "HBD" } } } }
  ],
  "because": "HBD stays liquid in the fleet: moved to savings or staked it is locked for days.",
